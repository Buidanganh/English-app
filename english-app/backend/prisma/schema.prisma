datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String          @id @default(uuid())
  email                 String          @unique
  passwordHash          String
  fullName              String?
  avatarUrl             String?
  role                  String          @default("USER")
  subscriptionTier      String          @default("FREE") // FREE, PLUS, PRO
  subscriptionExpiresAt DateTime?
  streakCount           Int             @default(0)
  totalXp               Int             @default(0)
  battleWins            Int             @default(0)
  battleTrophies        Int             @default(0)
  unlockedUnitIndex     Int             @default(1)
  lastClaimedRewardDate DateTime?
  lastActiveDate        DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  refreshTokens    RefreshToken[]
  progress         UserProgress[]
  vocabularies     UserVocabulary[]
  favorites        UserFavoriteVocabulary[]
  roleplaySessions RoleplaySession[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  level       String   @default("BEGINNER")
  iconUrl     String?
  orderIndex  Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       Unit[]

  @@map("courses")
}

model Unit {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  lessons     Lesson[]

  @@map("units")
}

model Lesson {
  id          String   @id @default(uuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title       String
  description String?
  xpReward    Int      @default(10)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  questions         Question[]
  lessonVocabularies LessonVocabulary[]
  userProgresses    UserProgress[]

  @@map("lessons")
}

model Vocabulary {
  id                 String   @id @default(uuid())
  word               String   @unique
  ipa                String?
  meaning            String
  audioUrl           String?
  imageUrl           String?
  exampleSentence    String?
  exampleTranslation String?
  createdAt          DateTime @default(now())

  lessonVocabularies LessonVocabulary[]
  userVocabularies   UserVocabulary[]
  favoritedBy        UserFavoriteVocabulary[]

  @@map("vocabularies")
}

model LessonVocabulary {
  lessonId     String
  vocabularyId String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@id([lessonId, vocabularyId])
  @@map("lesson_vocabularies")
}

model Question {
  id            String       @id @default(uuid())
  lessonId      String
  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type          String       // MULTIPLE_CHOICE, FILL_IN_BLANK, LISTEN_AND_SELECT, WORD_MATCHING, FLASHCARD
  prompt        String
  mediaUrl      String?
  options       String
  correctAnswer String
  explanation   String?
  orderIndex    Int          @default(0)

  @@map("questions")
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean  @default(false)
  score       Int      @default(0)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@map("user_progress")
}

model UserVocabulary {
  id           String      @id @default(uuid())
  userId       String
  vocabularyId String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary   Vocabulary  @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  status       String      @default("NEW") // NEW, LEARNING, MASTERED
  reviewCount  Int         @default(0)
  nextReviewAt DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, vocabularyId])
  @@map("user_vocabularies")
}

model UserFavoriteVocabulary {
  id           String     @id @default(uuid())
  userId       String
  vocabularyId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, vocabularyId])
  @@map("user_favorite_vocabularies")
}

model RoleplayScenario {
  id             String   @id @default(uuid())
  title          String
  description    String?
  category       String   @default("DAILY")
  icon           String   @default("💬")
  initialMessage String
  systemPrompt   String
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())

  sessions       RoleplaySession[]

  @@map("roleplay_scenarios")
}

model RoleplaySession {
  id          String   @id @default(uuid())
  userId      String
  scenarioId  String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario    RoleplayScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  score       Int      @default(0)
  feedback    String?  // JSON lưu nhận xét của AI
  isFinished  Boolean  @default(false)
  createdAt   DateTime @default(now())

  messages    RoleplayMessage[]

  @@map("roleplay_sessions")
}

model RoleplayMessage {
  id          String   @id @default(uuid())
  sessionId   String
  session     RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender      String   // "AI" | "USER"
  content     String
  translation String?
  createdAt   DateTime @default(now())

  @@map("roleplay_messages")
}

model VoiceBattleRoom {
  id             String   @id @default(uuid())
  player1Id      String
  player2Id      String?
  status         String   @default("PLAYING") // MATCHING, PLAYING, FINISHED
  player1Score   Int      @default(0)
  player2Score   Int      @default(0)
  winnerId       String?
  targetSentence String
  createdAt      DateTime @default(now())

  @@map("voice_battle_rooms")
}

model PaymentRequest {
  id             String    @id @default(uuid())
  userId         String
  tier           String    // PLUS | PRO
  durationMonths Int       @default(1)
  amount         Int       // VND
  memo           String    // Nội dung chuyển khoản để đối chiếu
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote      String?   // Ghi chú admin khi duyệt/từ chối
  approvedAt     DateTime?
  approvedBy     String?   // adminId
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("payment_requests")
}
